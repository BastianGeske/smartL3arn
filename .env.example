# Personal OpenRouter key. Restart Electron after changing this file.
# Development: copy this file to .env in the project root.
# Packaged macOS app: place .env in ~/Library/Application Support/smartL3arn/.
OPENROUTER_API_KEY=OPEN_ROUTER_API_KEY
# OpenRouter model ID. Empty values default to openrouter/free.
OPENROUTER_MODEL=openai/gpt-5.6-luna

# If 429/Rate-Limiting Change to anthropic/claude-opus-5.5
