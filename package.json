{
  "name": "smartl3arn",
  "version": "1.0.0",
  "description": "smartL3arn flashcard app with evidence-based learning techniques",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run build:web && electron .",
    "start:electron": "electron .",
    "typecheck": "vue-tsc -b",
    "test": "node --test electron/*.test.cjs && vitest run",
    "test:watch": "vitest",
    "test:smoke": "electron scripts/smoke-electron.cjs",
    "build:web": "vue-tsc -b && vite build",
    "build": "npm run build:web && electron-builder --mac dmg",
    "build:win": "npm run build:web && electron-builder --win",
    "build:all": "npm run build:web && electron-builder --mac dmg --win",
    "cap:copy": "npm run build:web && cap copy ios",
    "cap:sync": "npm run cap:copy && cap sync ios",
    "ios": "npm run cap:sync && cap open ios",
    "cap:copy:android": "npm run build:web && cap copy android",
    "cap:sync:android": "npm run cap:copy:android && cap sync android",
    "android": "npm run cap:sync:android && cap open android"
  },
  "build": {
    "appId": "com.smartl3arn.app",
    "productName": "smartL3arn",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*.cjs",
      "!electron/**/*.test.cjs",
      "!.env",
      "!.env.*",
      "web-dist/**/*",
      "build/icon.png",
      "!node_modules{,/**/*}"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "smartL3arn",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource-variable/manrope": "5.1.1",
    "@fontsource-variable/source-serif-4": "5.1.1",
    "@lucide/vue": "^1.28.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  }
}
