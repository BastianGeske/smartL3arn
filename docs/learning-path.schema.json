{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "smartL3arn learning path v1",
  "oneOf": [
    {
      "$ref": "#/definitions/content"
    },
    {
      "$ref": "#/definitions/needsSource"
    }
  ],
  "definitions": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "id",
        "version",
        "title",
        "chapters"
      ],
      "properties": {
        "format": {
          "const": "smartL3arn.learningPath"
        },
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "objectives"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "objectives": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "$ref": "#/definitions/objective"
                }
              }
            }
          }
        },
        "reviewCards": {
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "objectiveId",
              "front",
              "back"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "objectiveId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "front": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "back": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "dependencies": {
        "practiceExtras": [
          "selfCheckSize"
        ],
        "selfCheckSize": [
          "practiceExtras"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "selfCheckSize"
            ],
            "properties": {
              "selfCheckSize": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "type": "array",
                "minItems": 5
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "selfCheckSize"
            ],
            "properties": {
              "selfCheckSize": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "type": "array",
                "minItems": 6
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "selfCheckSize"
            ],
            "properties": {
              "selfCheckSize": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "type": "array",
                "minItems": 7
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "selfCheckSize"
            ],
            "properties": {
              "selfCheckSize": {
                "const": 6
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "type": "array",
                "minItems": 8
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "requiredEvidence"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "items": {
                  "required": [
                    "written"
                  ],
                  "properties": {
                    "written": {
                      "required": [
                        "language",
                        "input"
                      ],
                      "properties": {
                        "input": {
                          "const": "code"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "goal",
        "evidence",
        "source",
        "explanation",
        "example",
        "practice",
        "checks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "practice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "task",
            "hint",
            "solution",
            "feedback"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "task": {
              "$ref": "#/definitions/localTask"
            },
            "hint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "solution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "feedback": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "skillGroup": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            }
          }
        },
        "practiceExtras": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions/objective/properties/practice"
          }
        },
        "selfCheckSize": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        },
        "checks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "task",
              "hint",
              "solution",
              "feedback"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "task": {
                "allOf": [
                  {
                    "$ref": "#/definitions/localTask"
                  },
                  {
                    "not": {
                      "properties": {
                        "kind": {
                          "const": "true_false"
                        }
                      }
                    }
                  }
                ]
              },
              "hint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "solution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "written": {
                "$ref": "#/definitions/written"
              },
              "skillGroup": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              }
            }
          }
        },
        "opening": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "answer"
          ],
          "properties": {
            "question": {
              "$ref": "#/definitions/objective/properties/evidence"
            },
            "answer": {
              "$ref": "#/definitions/objective/properties/evidence"
            }
          }
        },
        "reviewChecks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/objective/properties/checks/items"
              },
              {
                "not": {
                  "required": [
                    "written"
                  ]
                }
              }
            ]
          }
        },
        "requiredEvidence": {
          "const": "code"
        },
        "contrastGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        }
      }
    },
    "localTask": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "answer"
          ],
          "properties": {
            "kind": {
              "const": "calculation"
            },
            "answer": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "const": "number"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "tolerance": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "numerator",
                    "denominator"
                  ],
                  "properties": {
                    "kind": {
                      "const": "fraction"
                    },
                    "numerator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "denominator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "pairs"
                  ],
                  "properties": {
                    "kind": {
                      "const": "quantity"
                    },
                    "pairs": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 50,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "value",
                          "unit"
                        ],
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048,
                            "pattern": "\\S"
                          },
                          "unit": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120,
                            "pattern": "\\S"
                          }
                        }
                      }
                    },
                    "tolerance": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    }
                  }
                }
              ]
            },
            "solutionSteps": {
              "type": "array",
              "minItems": 0,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "text",
                      "math"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 4000
                  }
                }
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options",
            "correctIds"
          ],
          "properties": {
            "kind": {
              "const": "single_choice"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  }
                }
              }
            },
            "correctIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options",
            "correctIds"
          ],
          "properties": {
            "kind": {
              "const": "multiple_choice"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  }
                }
              }
            },
            "correctIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "correct"
          ],
          "properties": {
            "kind": {
              "const": "true_false"
            },
            "correct": {
              "type": "boolean"
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "gaps"
          ],
          "properties": {
            "kind": {
              "const": "cloze"
            },
            "gaps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "answer"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "kind": {
                    "enum": [
                      "text",
                      "number"
                    ]
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  },
                  "alternatives": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pairs"
          ],
          "properties": {
            "kind": {
              "const": "matching"
            },
            "pairs": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "left",
                  "right"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "left": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  },
                  "right": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  }
                }
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items",
            "correctOrder"
          ],
          "properties": {
            "kind": {
              "const": "ordering"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  }
                }
              }
            },
            "correctOrder": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "written": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "reference",
        "criteria",
        "paraphrase",
        "partial",
        "misconception"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "input": {
          "enum": [
            "text",
            "code",
            "formula"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 480,
                "pattern": "\\S"
              }
            }
          }
        },
        "paraphrase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "partial": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "misconception": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "practiceOnly": {
          "type": "boolean"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "language"
            ]
          },
          "then": {
            "required": [
              "input"
            ],
            "properties": {
              "input": {
                "const": "code"
              }
            }
          }
        }
      ]
    },
    "needsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "missing"
      ],
      "properties": {
        "format": {
          "const": "smartL3arn.needsSource"
        },
        "schemaVersion": {
          "const": 1
        },
        "missing": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
